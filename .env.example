# Copie para .env e preencha com valores reais. Nunca commite o .env.

# --- Postgres ---
# orquestra_owner é o superusuário do cluster (aplica DDL/migrações).
POSTGRES_USER=orquestra_owner
POSTGRES_PASSWORD=
POSTGRES_DB=orquestra
POSTGRES_PORT=5432

# Senha do papel de aplicação (DML apenas, NOBYPASSRLS) — criado pelo init.sh do Postgres.
ORQUESTRA_APP_DB_PASSWORD=

# Usada pela aplicação (api/worker/scheduler) em runtime — aponta para orquestra_app.
# Preencha com os mesmos valores usados acima; estas variáveis não se auto-expandem.
DATABASE_URL=postgres://orquestra_app:<ORQUESTRA_APP_DB_PASSWORD>@localhost:5432/orquestra

# Usada só para aplicar migrações — aponta para orquestra_owner.
DATABASE_MIGRATION_URL=postgres://orquestra_owner:<POSTGRES_PASSWORD>@localhost:5432/orquestra

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3000
PROCESS_ROLE=api

# Segredo usado para assinar o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=

# --- Cofre de credenciais (ADR-001) ---
# A KEK NÃO é variável de ambiente (vaza em `docker inspect`/dump de processo) — é um
# arquivo montado como Docker secret. KEK_DIR já vem fixo no compose (/run/secrets/kek)
# e não precisa entrar no .env. Antes do primeiro `pnpm dev`, gere a versão 1:
#   openssl rand -out docker/secrets/kek/1 32
# Perder esse arquivo torna irrecuperável toda credencial de conector já cadastrada.

# --- Web ---
WEB_PORT=5173
